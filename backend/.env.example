# =============================================================================
# DecodeAI Backend Environment Configuration
# =============================================================================
# Primary AI Provider: Google Gemini (Backend only, never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30.0

# Secondary AI Provider: Groq Automatic Fallback (Optional but recommended for 429/503 fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=25.0
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Environment Mode: 'development', 'production', or 'test'
ENVIRONMENT=production

# Allowed CORS Origins (comma-separated or JSON list without trailing slashes)
# In production on Render: Set to your public frontend URL (e.g. https://decodeai-frontend.onrender.com)
ALLOWED_ORIGINS=https://decodeai-frontend.onrender.com,http://localhost:5173

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=15
