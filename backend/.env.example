# Google Gemini API Key (Backend only, never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model configuration (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30.0

# Groq Fallback Provider (Secondary provider, used on 429/503/timeout)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=25.0


# Environment and Network configuration
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_PER_MINUTE=10
