# =============================================================================
# DecodeAI Frontend Environment Configuration
# =============================================================================
# Public backend API URL for production deployment on Render.
# - Local dev: Leave empty to leverage the Vite proxy (http://localhost:8000 via /api).
# - Production on Render: Set to your Render backend web service URL (e.g. https://decodeai-backend.onrender.com).
# IMPORTANT: Never include private provider API keys (Gemini, Groq) in frontend env variables.
VITE_API_BASE_URL=https://decodeai-backend.onrender.com
